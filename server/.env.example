MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=healthpulse

# Reddit API — register free at reddit.com/prefs/apps (type: script)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=HealthPulse/1.0 by YourRedditUsername

# TwitterAPI.io — provided by hackathon organizers
TWITTER_API_KEY=your_twitterapi_io_key

# LLM APIs — all FREE tiers, sign up takes 2 minutes each
# Groq (PRIMARY) — console.groq.com → API Keys → Create key
GROQ_API_KEY=your_groq_api_key

# Gemini (FALLBACK 1) — aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_api_key

# Mistral (FALLBACK 2) — console.mistral.ai → API Keys
MISTRAL_API_KEY=your_mistral_api_key

# OpenFDA — no key needed, free public API
FAERS_BASE_URL=https://api.fda.gov/drug/event.json

# Server
PORT=8000
FRONTEND_URL=http://localhost:3000
